# Real-Time Transcription Platform - Environment Variables

# PostgreSQL
DATABASE_URL=postgresql://transcribe:transcribe@localhost:5432/realtime_transcribe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Storage (MinIO/S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_AUDIO=audio-recordings
STORAGE_BUCKET_MODELS=ml-models
STORAGE_USE_SSL=false

# ASR Configuration
WHISPER_MODEL=large-v3  # Options: tiny, base, small, medium, large-v3
DEVICE=cpu  # Options: cpu, cuda
COMPUTE_TYPE=float32  # Options: float32, float16, int8

# Diarization
HF_AUTH_TOKEN=  # Hugging Face token for pyannote models

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Service Names (for logging/monitoring)
SERVICE_NAME=realtime-transcribe
